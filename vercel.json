{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/affiliate/click", "destination": "/api/affiliate/products" },
    { "source": "/", "destination": "/FlashMarket/index.html" },
    { "source": "/:path*", "destination": "/FlashMarket/:path*" }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  }
}
